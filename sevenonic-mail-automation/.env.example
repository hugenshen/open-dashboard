APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/sevenonic.db
ARTIFACT_ROOT=./artifacts
ADMIN_TOKEN=replace-with-long-random-value

# Microsoft Entra / Graph — do not commit real values.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_CLIENT_STATE=replace-with-random-webhook-secret
GRAPH_NOTIFICATION_URL=https://example.com/webhooks/graph
GRAPH_LIFECYCLE_URL=https://example.com/webhooks/graph/lifecycle
# JSON array. folder_id may be "inbox" or a real Graph folder ID.
GRAPH_MAILBOXES_JSON=[{"mailbox_id":"po@sevenonic.com","folder_id":"inbox"}]

# monday.com — query the real board schema before filling column IDs.
MONDAY_API_TOKEN=
MONDAY_API_VERSION=2026-07
MONDAY_BOARD_ID=
MONDAY_GROUP_ID=
MONDAY_EVENT_COLUMN_ID=event_id
MONDAY_STYLE_COLUMN_ID=style_id
MONDAY_REVISION_COLUMN_ID=tech_pack_revision
MONDAY_REVIEW_STATUS_COLUMN_ID=review_status
MONDAY_REVIEW_STATUS_LABEL=待人工复核

SYNC_INTERVAL_SECONDS=900
SUBSCRIPTION_RENEW_BEFORE_SECONDS=86400
WORKER_IDLE_SECONDS=2
