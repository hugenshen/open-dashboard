# Open Dashboard — Docker Compose defaults (copy to .env to override)

# Host ports
OD_WEB_PORT=8088
OD_API_PORT=8080
OD_PG_PORT=5434

# Meta database (also used as bootstrap demo datasource)
POSTGRES_DB=opendashboard
POSTGRES_USER=opendashboard
POSTGRES_PASSWORD=opendashboard

# Backend
SPRING_PROFILES_ACTIVE=docker
OD_BOOTSTRAP_META_DATASOURCE=true
