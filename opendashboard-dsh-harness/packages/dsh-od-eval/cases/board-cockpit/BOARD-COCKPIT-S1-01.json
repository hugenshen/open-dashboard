      {
        "type": "pie",
        "intent": "compose",
        "title": "类型构成",
        "datasetId": "ds_orders",
        "encode": { "category": "MchType", "value": "MchType", "agg": "count" }
      },
      {
        "type": "hbar",
        "intent": "rank",
        "title": "商户类型排行",
        "datasetId": "ds_orders",
        "encode": { "category": "MchType", "value": "MchIncome", "agg": "sum" }
      },
      {
        "type": "bar",
        "intent": "compare",
        "title": "空渠道",
        "datasetId": "ds_orders",
        "encode": { "category": "MchType", "value": "Amount", "agg": "sum" }
