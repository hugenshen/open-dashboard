# Copy to .env or export in shell before starting harness.

OD_BI_BASE=http://127.0.0.1:8082
OD_INTERNAL_TOKEN=od-dev-internal
OD_HARNESS_PORT=8091

# auto | lead | deterministic
OD_HARNESS_MODE=auto

# OpenAI-compatible Lead LLM (required for Lead Agent)
OD_LLM_BASE_URL=https://api.openai.com/v1
OD_LLM_API_KEY=
OD_LLM_MODEL=gpt-4o-mini
OD_LLM_TIMEOUT_S=120
