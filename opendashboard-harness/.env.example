# Copy to .env（启动时自动加载；.env 已 gitignore）

OD_BI_BASE=http://127.0.0.1:8082
OD_INTERNAL_TOKEN=od-dev-internal
OD_HARNESS_PORT=8091

# auto | lead | deterministic
OD_HARNESS_MODE=auto

# OpenAI-compatible Lead LLM
# DeepSeek Pro 示例：
#   OD_LLM_BASE_URL=https://api.deepseek.com/v1
#   OD_LLM_MODEL=deepseek-v4-pro
OD_LLM_BASE_URL=https://api.deepseek.com/v1
OD_LLM_API_KEY=
OD_LLM_MODEL=deepseek-v4-pro
OD_LLM_TIMEOUT_S=180
